{
  "id": "keybind-basic",
  "name": "热键骨架",
  "version": 1,
  "description": "生成 KeyMapping 注册骨架与语言键。",
  "loaders": [
    "forge"
  ],
  "mcVersion": "1.20.1",
  "category": "keybind",
  "parameters": [
    {
      "key": "id",
      "type": "string",
      "required": true
    },
    {
      "key": "displayName",
      "type": "string",
      "required": true
    },
    {
      "key": "package",
      "type": "string",
      "default": ""
    },
    {
      "key": "key",
      "type": "string",
      "default": "K"
    }
  ],
  "apiRefs": [
    "net.minecraft.client.KeyMapping",
    "net.minecraftforge.client.event.RegisterKeyMappingsEvent"
  ],
  "files": [
    {
      "path": "src/main/java/{{packagePath}}/client/{{ClassName}}Keybind.java",
      "template": "files/keybind.java.tpl",
      "when": "always"
    },
    {
      "path": "src/main/resources/assets/{{modid}}/lang/zh_cn.json",
      "template": "files/lang-zh.json.tpl",
      "when": "always",
      "merge": "json"
    },
    {
      "path": "src/main/resources/assets/{{modid}}/lang/en_us.json",
      "template": "files/lang-en.json.tpl",
      "when": "always",
      "merge": "json"
    }
  ],
  "checks": [
    "lang-key"
  ]
}
