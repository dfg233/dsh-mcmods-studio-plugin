{
  "id": "effect-basic",
  "name": "状态效果骨架",
  "version": 1,
  "description": "生成 MobEffect 子类骨架与语言键。",
  "loaders": [
    "forge"
  ],
  "mcVersion": "1.20.1",
  "category": "effect",
  "parameters": [
    {
      "key": "id",
      "type": "string",
      "required": true
    },
    {
      "key": "displayName",
      "type": "string",
      "required": true
    },
    {
      "key": "package",
      "type": "string",
      "default": ""
    },
    {
      "key": "color",
      "type": "string",
      "default": "ff5555"
    }
  ],
  "apiRefs": [
    "net.minecraft.world.effect.MobEffect",
    "net.minecraft.world.effect.MobEffectCategory"
  ],
  "files": [
    {
      "path": "src/main/java/{{packagePath}}/effect/{{ClassName}}Effect.java",
      "template": "files/effect.java.tpl",
      "when": "always"
    },
    {
      "path": "src/main/resources/assets/{{modid}}/lang/zh_cn.json",
      "template": "files/lang-zh.json.tpl",
      "when": "always",
      "merge": "json"
    },
    {
      "path": "src/main/resources/assets/{{modid}}/lang/en_us.json",
      "template": "files/lang-en.json.tpl",
      "when": "always",
      "merge": "json"
    }
  ],
  "checks": [
    "lang-key"
  ]
}
