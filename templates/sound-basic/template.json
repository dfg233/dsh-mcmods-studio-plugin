{
  "id": "sound-basic",
  "name": "声音骨架",
  "version": 1,
  "description": "生成 sounds.json 条目与语言键。",
  "loaders": [
    "forge"
  ],
  "mcVersion": "1.20.1",
  "category": "sound",
  "parameters": [
    {
      "key": "id",
      "type": "string",
      "required": true
    },
    {
      "key": "displayName",
      "type": "string",
      "required": true
    }
  ],
  "apiRefs": [
    "net.minecraft.sounds.SoundEvent"
  ],
  "files": [
    {
      "path": "src/main/resources/assets/{{modid}}/sounds.json",
      "template": "files/sounds.json.tpl",
      "when": "always",
      "merge": "json"
    },
    {
      "path": "src/main/resources/assets/{{modid}}/lang/zh_cn.json",
      "template": "files/lang-zh.json.tpl",
      "when": "always",
      "merge": "json"
    }
  ],
  "checks": [
    "resource-exists"
  ]
}
