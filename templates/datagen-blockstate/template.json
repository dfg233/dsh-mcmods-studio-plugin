{
  "id": "datagen-blockstate",
  "name": "BlockState Provider",
  "version": 1,
  "description": "生成 ModBlockStateProvider（simpleBlockWithItem / 门 / 活板门 / 告示牌 / 原木）。",
  "loaders": [
    "forge"
  ],
  "mcVersion": "1.20.1",
  "category": "datagen",
  "parameters": [
    {
      "key": "package",
      "type": "string",
      "default": ""
    }
  ],
  "apiRefs": [
    "net.minecraftforge.client.model.generators.BlockStateProvider"
  ],
  "files": [
    {
      "path": "src/main/java/{{packagePath}}/datagen/ModBlockStateProvider.java",
      "template": "files/blockstate.java.tpl",
      "when": "always"
    }
  ],
  "checks": [
    "resource-exists"
  ]
}
