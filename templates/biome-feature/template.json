{
  "id": "biome-feature",
  "name": "地物生成",
  "version": 1,
  "description": "生成 placed_feature 与 configured_feature JSON 骨架。",
  "loaders": [
    "forge"
  ],
  "mcVersion": "1.20.1",
  "category": "biome",
  "parameters": [
    {
      "key": "feature",
      "type": "string",
      "required": true
    }
  ],
  "apiRefs": [
    "net.minecraft.world.level.levelgen.placement.PlacedFeature"
  ],
  "files": [
    {
      "path": "src/main/resources/data/{{modid}}/worldgen/placed_feature/{{feature}}.json",
      "template": "files/placed_feature.json.tpl",
      "when": "always"
    },
    {
      "path": "src/main/resources/data/{{modid}}/worldgen/configured_feature/{{feature}}.json",
      "template": "files/configured_feature.json.tpl",
      "when": "always"
    }
  ],
  "checks": [
    "resource-exists"
  ]
}
