{
  "id": "datagen-worldgen",
  "name": "WorldGen Provider",
  "version": 1,
  "description": "生成 ModWorldGenProvider 骨架（Configured/Placed/BiomeModifier 注册入口）。",
  "loaders": [
    "forge"
  ],
  "mcVersion": "1.20.1",
  "category": "datagen",
  "parameters": [
    {
      "key": "package",
      "type": "string",
      "default": ""
    }
  ],
  "apiRefs": [
    "net.minecraftforge.common.data.DatapackBuiltinEntriesProvider"
  ],
  "files": [
    {
      "path": "src/main/java/{{packagePath}}/datagen/ModWorldGenProvider.java",
      "template": "files/worldgen.java.tpl",
      "when": "always"
    }
  ],
  "checks": [
    "resource-exists"
  ]
}
