{
  "id": "smithing-recipe",
  "name": "锻造配方",
  "version": 1,
  "description": "生成 smithing_transform 配方 JSON。",
  "loaders": [
    "forge"
  ],
  "mcVersion": "1.20.1",
  "category": "recipe",
  "parameters": [
    {
      "key": "id",
      "type": "string",
      "required": true
    },
    {
      "key": "result",
      "type": "string",
      "required": true
    },
    {
      "key": "template",
      "type": "string",
      "required": true
    },
    {
      "key": "base",
      "type": "string",
      "required": true
    },
    {
      "key": "addition",
      "type": "string",
      "required": true
    }
  ],
  "apiRefs": [
    "net.minecraft.data.recipes.RecipeProvider"
  ],
  "files": [
    {
      "path": "src/main/resources/data/{{modid}}/recipes/{{result}}.json",
      "template": "files/recipe.json.tpl",
      "when": "always"
    }
  ],
  "checks": [
    "resource-exists"
  ]
}
