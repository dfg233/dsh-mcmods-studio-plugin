{
  "id": "shaped-recipe",
  "name": "有序配方",
  "version": 1,
  "description": "生成 3x3 单材料有序配方 JSON。",
  "loaders": [
    "forge",
    "neoforge"
  ],
  "mcVersion": "1.20.1",
  "category": "recipe",
  "parameters": [
    {
      "key": "id",
      "type": "string",
      "required": true
    },
    {
      "key": "ingredient",
      "type": "string",
      "default": "minecraft:stone"
    },
    {
      "key": "count",
      "type": "number",
      "default": 1
    }
  ],
  "files": [
    {
      "path": "src/main/resources/data/{{modid}}/recipes/{{id}}.json",
      "template": "files/recipe.json.tpl",
      "when": "always"
    }
  ],
  "checks": [
    "resource-exists"
  ]
}
