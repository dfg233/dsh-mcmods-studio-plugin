{
  "id": "simple-item",
  "name": "普通物品",
  "version": 1,
  "description": "生成物品类、物品模型与中英文语言键；注册行由任务模板或用户补。",
  "loaders": [
    "forge",
    "neoforge"
  ],
  "mcVersion": "1.20.1",
  "category": "item",
  "parameters": [
    {
      "key": "id",
      "type": "string",
      "required": true
    },
    {
      "key": "displayName",
      "type": "string",
      "required": true
    },
    {
      "key": "stackSize",
      "type": "number",
      "default": 64
    },
    {
      "key": "package",
      "type": "string",
      "default": ""
    }
  ],
  "apiRefs": [
    "net.minecraft.world.item.Item",
    "net.minecraft.world.item.Item$Properties"
  ],
  "files": [
    {
      "path": "src/main/java/{{package}}/item/{{ClassName}}.java",
      "template": "files/item.java.tpl",
      "when": "always"
    },
    {
      "path": "src/main/resources/assets/{{modid}}/models/item/{{id}}.json",
      "template": "files/model.json.tpl",
      "when": "always"
    },
    {
      "path": "src/main/resources/assets/{{modid}}/lang/zh_cn.json",
      "template": "files/lang-zh.json.tpl",
      "when": "always",
      "merge": "json"
    },
    {
      "path": "src/main/resources/assets/{{modid}}/lang/en_us.json",
      "template": "files/lang-en.json.tpl",
      "when": "always",
      "merge": "json"
    }
  ],
  "checks": [
    "resource-exists",
    "lang-key"
  ]
}
