{
  "id": "biome-modifier",
  "name": "群系注入",
  "version": 1,
  "description": "生成 forge:add_features 的 biome modifier JSON。",
  "loaders": [
    "forge"
  ],
  "mcVersion": "1.20.1",
  "category": "biome",
  "parameters": [
    {
      "key": "biome",
      "type": "string",
      "required": true
    },
    {
      "key": "feature",
      "type": "string",
      "required": true
    }
  ],
  "apiRefs": [
    "net.minecraftforge.common.world.BiomeModifier"
  ],
  "files": [
    {
      "path": "src/main/resources/data/{{modid}}/forge/biome_modifier/{{biome}}_{{feature}}.json",
      "template": "files/modifier.json.tpl",
      "when": "always"
    }
  ],
  "checks": [
    "resource-exists"
  ]
}
