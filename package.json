{
  "name": "dsh-mcmods-studio-plugin",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "模组工坊：面向 Minecraft 1.20.1（Forge / NeoForge / Fabric）的模组设计、物品属性文档与贴图模型管理插件",
  "icon": "icon.svg",
  "main": "index.js",
  "scripts": {
    "test": "node test/run.mjs",
    "gen:schema": "node scripts/gen-schema.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "test/**",
    "scripts/**",
    "data/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "docs/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
